# Supabase - get from https://supabase.com/dashboard/project/nnqhknrqpbalgqwfiulh/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://nnqhknrqpbalgqwfiulh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Flutterwave - get from https://dashboard.flutterwave.com/settings/apis
# Supports NGN, USD, GBP, EUR, KES, GHS and 150+ currencies
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-your_public_key_here
FLW_SECRET_KEY=FLWSECK_TEST-your_secret_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
